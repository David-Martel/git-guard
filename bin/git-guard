#!/bin/sh
#
# git-guard — account-wide git-safety + language-gated QA, CLI front-end.
#
# Subcommands:
#   status     show install state, version, resolved rules dir
#   doctor     check prerequisites (git, ast-grep, shellcheck, ruff, cygpath…)
#   rules      print the rule manifest (categories, counts, the BLOCK trio)
#   verify     self-test: BLOCK trio fires, clean commit passes (scratch repo)
#   test       run the comprehensive validation suite (tests/), hermetic temp repos
#   install    install a versioned release (delegates to install.sh; default
#              --to v$(cat VERSION); accepts --to/--store/--rules-dir/--dev-symlink/--dry-run)
#   update     re-point the installed `current` release at another tag
#              (git-guard update --to <tag>) — an atomic swap; every consuming
#              repo's hooks change together, never half-installed
#   uninstall  remove the hooks (delegates to install.sh --uninstall)
#   version    print the version of THIS checkout (not necessarily what's installed)
#   help       this message
#
# No machine-specific paths: everything resolves relative to this script.

set -u

# --- Locate the git-guard root (this file is at <root>/bin/git-guard) ---
# `-P`: same reasoning as hooks/pre-commit -- pin the physical version this
# invocation resolved to, independent of a concurrent `update` re-pointing
# `current` mid-run.
GG_BIN_DIR="$(cd "$(dirname "$0")" && pwd -P)"
GG_ROOT="$(cd "$GG_BIN_DIR/.." && pwd -P)"
GG_HOOKS="$GG_ROOT/hooks"
GG_ENGINE="$GG_HOOKS/common"
GG_CONF="$GG_ENGINE/qa-gate.conf"
GG_BUNDLED_RULES="$GG_ROOT/rules-examples"

have() { command -v "$1" >/dev/null 2>&1; }
gg_version() { [ -f "$GG_ROOT/VERSION" ] && cat "$GG_ROOT/VERSION" || echo "0.0.0"; }

# Resolve what is ACTUALLY installed via core.hooksPath, independent of which
# copy of `bin/git-guard` is running this (a dev checkout, or the installed
# ~/.local/share/git-guard/current/bin/git-guard). `pwd -P` fully resolves
# through both the ~/.git-hooks symlink AND the `current` symlink it points at
# (in versioned-install mode) down to the physical <store>/<tag>/hooks dir;
# its parent is the version dir, which carries its own VERSION + commit marker.
gg_installed_hooks_physical() {
  ghp="$(git config --global core.hooksPath 2>/dev/null || echo '')"
  [ -n "$ghp" ] || return 1
  # shellcheck disable=SC2088  # intentional: matching a LITERAL leading "~/"
  # in a stored git-config value (never expanded by git itself), not asking
  # the shell to expand a tilde.
  case "$ghp" in "~/"*) ghp="$HOME/${ghp#\~/}" ;; esac
  ( cd "$ghp" 2>/dev/null && pwd -P )
}
gg_installed_version() {
  hooks_phys="$(gg_installed_hooks_physical)" || { echo "<unset>"; return 1; }
  ver_dir="$(dirname "$hooks_phys")"
  if [ -f "$ver_dir/VERSION" ]; then
    v="$(cat "$ver_dir/VERSION")"
    if [ -f "$ver_dir/.git-guard-commit" ]; then
      printf '%s (versioned install, %s, commit %s)' "$v" "$ver_dir" "$(cat "$ver_dir/.git-guard-commit")"
    else
      printf '%s (--dev-symlink checkout, %s)' "$v" "$ver_dir"
    fi
  else
    printf '<unknown: %s has no VERSION file>' "$ver_dir"
    return 1
  fi
}

# Resolve the active rules dir the same way qa_gate.sh does (env > conf > bundled).
gg_rules_dir() {
  if [ -n "${GIT_GUARD_RULES_DIR:-}" ] && [ -d "${GIT_GUARD_RULES_DIR}" ]; then
    printf '%s' "$GIT_GUARD_RULES_DIR"; return
  fi
  rd="$(grep -E '^[[:space:]]*rules_dir[[:space:]]*=' "$GG_CONF" 2>/dev/null | head -n1 | sed 's/^[^=]*=//; s/[[:space:]]*#.*$//; s/^[[:space:]]*//; s/[[:space:]]*$//')"
  if [ -n "$rd" ] && [ -d "$rd" ]; then printf '%s' "$rd"; return; fi
  printf '%s' "$GG_BUNDLED_RULES"
}

cmd_status() {
  echo "git-guard $(gg_version) (this checkout: $GG_ROOT)"
  echo "  global hooks:      $(git config --global core.hooksPath 2>/dev/null || echo '<unset>')"
  echo "  installed version: $(gg_installed_version)"
  rd="$(gg_rules_dir)"
  echo "  rules dir:         $rd"
  echo "  rule source:       $( [ "$rd" = "$GG_BUNDLED_RULES" ] && echo 'bundled rules-examples (public default)' || echo 'overlay (env/conf)' )"
  # Is ~/.git-hooks pointing at THIS checkout specifically (only true under
  # --dev-symlink, or when this checkout IS the materialized version dir)?
  ghp="$(git config --global core.hooksPath 2>/dev/null || echo '')"
  if [ -n "$ghp" ]; then
    real_ghp="$(cd "$ghp" 2>/dev/null && pwd -P || echo "$ghp")"
    if [ "$real_ghp" = "$(cd "$GG_HOOKS" 2>/dev/null && pwd -P)" ]; then
      echo "  this checkout:     IS the active install (core.hooksPath resolves here)"
    else
      echo "  this checkout:     NOT the active install (active: $real_ghp)"
    fi
  else
    echo "  this checkout:     NOT installed anywhere (run: git-guard install)"
  fi
}

# True only when `sg` on PATH is genuinely ast-grep (not util-linux set-group).
sg_is_astgrep() { have sg && sg --version 2>/dev/null | grep -qi 'ast-grep'; }
astgrep_is_astgrep() { have ast-grep && ast-grep --version 2>/dev/null | grep -qi 'ast-grep'; }
cmd_doctor() {
  echo "git-guard doctor — prerequisite check"
  echo "  installed version: $(gg_installed_version)"
  for t in git sg ast-grep shellcheck ruff python pwsh cygpath dotnet cargo; do
    if [ "$t" = sg ]; then
      if sg_is_astgrep; then printf '  [ok]   %-12s %s (ast-grep)\n' "$t" "$(command -v sg)"
      elif have sg; then printf '  [warn] %-12s %s (NOT ast-grep — shadowed; ast-grep used instead)\n' "$t" "$(command -v sg)"
      else printf '  [--]   %-12s (absent — related checks self-skip)\n' "$t"; fi
    elif have "$t"; then printf '  [ok]   %-12s %s\n' "$t" "$(command -v "$t")"
    else printf '  [--]   %-12s (absent — related checks self-skip)\n' "$t"; fi
  done
  echo ""
  if sg_is_astgrep || astgrep_is_astgrep; then echo "  ast-grep present -> structural BLOCK trio active"; else echo "  ast-grep ABSENT -> ast-grep layer self-skips (trio inactive)"; fi
}

cmd_rules() {
  rd="$(gg_rules_dir)"
  echo "git-guard rule manifest"
  echo "  source: $rd"
  echo ""
  total=0
  for d in core security rust rust/panics csharp powershell python typescript; do
    n=$(ls "$rd/$d"/*.yml 2>/dev/null | wc -l | tr -d ' ')
    [ "$n" -gt 0 ] && printf '  %-14s %3d rules\n' "$d" "$n"
    total=$((total + n))
  done
  printf '  %-14s %3d rules\n' "TOTAL" "$total"
  echo ""
  echo "  BLOCK trio (always blocks unless astgrep=off):"
  echo "    avoid-static-mut · no-glob-reexport · unsafe-with-panic"
  echo "  Everything else: WARN (or block if astgrep=block in qa-gate.conf)."
}

cmd_verify() {
  echo "git-guard verify — self-test"
  # Skip cleanly unless a GENUINE ast-grep CLI is available. A bare `have sg` is
  # NOT enough: on Linux/WSL /usr/bin/sg is util-linux's set-group, which shadows
  # ast-grep and makes the structural trio silently no-op. Use the same
  # sg_is_astgrep probe doctor uses, so the WSL backend SKIPs (rc 0) instead of
  # reporting a spurious FAIL when ast-grep is genuinely absent.
  if ! sg_is_astgrep && ! astgrep_is_astgrep; then echo "  SKIP: no ast-grep CLI (cannot test the trio)"; return 0; fi
  t="$(mktemp -d)" || { echo "  FAIL: mktemp"; return 1; }
  ( cd "$t" && git init -q && git config user.email t@t.t && git config user.name t && git config commit.gpgsign false
    mkdir -p src; printf 'static mut C: u32 = 0;\nfn main(){ unsafe { C += 1; } }\n' > src/bad.rs; git add -A )
  if sh "$GG_ENGINE/qa_gate.sh" >/dev/null 2>&1 -- 2>/dev/null; then : ; fi
  ( cd "$t" && sh "$GG_ENGINE/qa_gate.sh" >/dev/null 2>&1 ); rc=$?
  [ "$rc" -eq 1 ] && echo "  [ok]   BLOCK trio (static mut) -> commit refused (exit 1)" || echo "  [FAIL] static mut did NOT block (exit $rc)"
  rm -rf "$t"; t="$(mktemp -d)"
  ( cd "$t" && git init -q && echo '# x' > README.md && git add -A )
  ( cd "$t" && sh "$GG_ENGINE/qa_gate.sh" >/dev/null 2>&1 ); rc2=$?
  [ "$rc2" -eq 0 ] && echo "  [ok]   clean docs commit -> allowed (exit 0)" || echo "  [FAIL] clean commit blocked (exit $rc2)"
  rm -rf "$t"
  [ "${rc:-9}" -eq 1 ] && [ "${rc2:-9}" -eq 0 ] && echo "  RESULT: PASS" || { echo "  RESULT: FAIL"; return 1; }
}

cmd_install()   { sh "$GG_ROOT/install.sh" "$@"; }
cmd_uninstall() { sh "$GG_ROOT/install.sh" --uninstall "$@"; }
# `update` is the same atomic materialize+flip operation as `install`, just
# named for the "re-point an existing install at a different tag" case. It
# requires --to explicitly (no implicit "this checkout's own VERSION" default,
# unlike bare `install`) so an update is never accidentally a no-op re-run of
# whatever tag happens to be checked out here.
cmd_update() {
  case " $* " in
    *" --to "*) : ;;
    *) echo "git-guard update: --to <tag> is required (e.g. git-guard update --to v0.2.0)" >&2; return 2 ;;
  esac
  sh "$GG_ROOT/install.sh" "$@"
}

# Run the comprehensive validation suite under tests/ (hermetic temp repos).
# Each test self-skips with a reason when a required tool/platform is absent, so
# this stays green across native / WSL / Docker / CI. Passes any args through to
# the runner (e.g. a single test name).
cmd_test() {
  runner="$GG_ROOT/tests/run.sh"
  [ -f "$runner" ] || { echo "git-guard test: tests/run.sh not found at $runner" >&2; return 2; }
  sh "$runner" "$@"
}

cmd_help() {
  awk '
    NR == 1 { next }
    /^#/ { sub(/^# ?/, ""); print; next }
    { exit }
  ' "$0"
}

case "${1:-help}" in
  status)     cmd_status ;;
  doctor)     cmd_doctor ;;
  rules)      cmd_rules ;;
  verify)     cmd_verify ;;
  test)       shift; cmd_test "$@" ;;
  install)    shift; cmd_install "$@" ;;
  update)     shift; cmd_update "$@" ;;
  uninstall)  shift; cmd_uninstall "$@" ;;
  version|--version|-v) gg_version ;;
  help|--help|-h|*) cmd_help ;;
esac
