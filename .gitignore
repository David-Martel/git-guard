# Runtime rule cache — REGENERATED by qa_gate.sh from the active rules dir on
# first commit; machine-specific (absolute paths) and must never be committed.
hooks/common/qa-rules/

# Generated effective sgconfig (absolute, cygpath-converted ruleDirs).
**/sgconfig.generated.yml

# Local deployment artifacts written by install.sh into a DEPLOYED copy
# (the committed tree stays public-safe; the installed copy gets the overlay).
*.local
.git-guard-installed
hooks/common/qa-gate.conf.local

# Backups created by install.sh before it touches an existing hooks dir.
*.pre-git-guard-backup/
*.bak

# OS / editor noise
.DS_Store
Thumbs.db
*~

# In-repository agent worktrees (kept local and removed after merge).
worktrees/
