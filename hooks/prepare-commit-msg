#!/bin/sh
# Deterministically attribute commits created by AI coding agents.
#
#   Codex       -> `Agent: codex` + `Co-authored-by: Codex <noreply@openai.com>`
#   Claude Code -> `Agent: claude` (Claude writes its own Co-authored-by, which
#                  names the model, so the hook never adds or duplicates one)
#   human       -> no trailer
#
# Git always runs prepare-commit-msg, even with --no-verify. A human who must
# make an emergency commit can bypass this hook explicitly with GIT_GUARD=0.
# The message source ($2: message/template/merge/squash/commit) is deliberately
# not special-cased: every commit an agent creates is attributed the same way.

set -u

if [ "${GIT_GUARD:-1}" = "0" ]; then
  exit 0
fi

message_file="${1:-}"
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  printf 'git-guard prepare-commit-msg: commit message file is missing\n' >&2
  exit 1
fi

# An explicit agent selector takes precedence. Otherwise:
#   * CODEX_THREAD_ID is the stable process-level signal exported by Codex CLI.
#     Only that variable counts: Claude Code shells can carry unrelated CODEX_*
#     configuration (CODEX_MODEL, CODEX_ENABLED, ...).
#   * CLAUDECODE=1 / CLAUDE_CODE_ENTRYPOINT are exported by Claude Code into
#     every shell it spawns.
# Codex outranks Claude: a Codex process launched from inside Claude Code
# inherits CLAUDECODE=1 but carries its own CODEX_THREAD_ID, and the
# per-process marker beats the inherited ancestor marker.
case "${GIT_GUARD_AGENT:-}" in
  codex) agent=codex ;;
  claude) agent=claude ;;
  "")
    if [ -n "${CODEX_THREAD_ID:-}" ]; then
      agent=codex
    elif [ "${CLAUDECODE:-}" = "1" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
      agent=claude
    else
      agent=""
    fi
    ;;
  *) agent="" ;;
esac

if [ -z "$agent" ]; then
  exit 0
fi

# Inspect every trailer-shaped Agent line, including case and whitespace forms
# Git accepts. Multiple `git commit -m` paragraphs can put blank lines between
# trailers, so checking only `interpret-trailers --parse` is insufficient.
conflicting_agent="$(awk -v agent="$agent" '
  BEGIN { conflict = "" }
  {
    line = $0
    lower = tolower(line)
    if (lower ~ /^agent[[:space:]]*:/) {
      sub(/^[^:]*:[[:space:]]*/, "", line)
      sub(/^[[:space:]]+/, "", line)
      sub(/[[:space:]]+$/, "", line)
      if (tolower(line) != agent && conflict == "") {
        conflict = (line == "" ? "<empty>" : line)
      }
    }
  }
  END { printf "%s\n", conflict }
' "$message_file")"

if [ -n "$conflicting_agent" ]; then
  printf 'git-guard prepare-commit-msg: conflicting Agent trailer: %s (detected agent: %s)\n' \
    "$conflicting_agent" "$agent" >&2
  printf 'Set GIT_GUARD=0 only for an intentional human emergency commit.\n' >&2
  exit 1
fi

# A matching Agent line in an earlier paragraph is body text, not a parsed
# trailer. Let Git find the final trailer block; retain that earlier text.
# `--if-exists replace` canonicalizes Agent's spelling and keeps repeated hook
# invocations byte-identical.
case "$agent" in
  codex)
    # Codex co-author: `Codex <noreply@openai.com>`, the address the Codex CLI
    # itself writes (openai/codex codex-rs/ext/git-attribution/src/world_state.rs)
    # and OpenAI's documented default. Owner decision 2026-10-03, for
    # consistency with Codex-authored commits; GitHub links it to OpenAI's own
    # `codex` account, as it already did for the earlier address.
    #
    # Earlier generated forms are COLLAPSED into it rather than duplicated:
    #   Codex <codex@users.noreply.github.com>   this hook until 2026-10-03
    #   Codex <codex@agents.invalid>             an unmerged draft of this change
    # Each is removed ONLY as that exact, complete logical trailer (never the
    # first line of a folded trailer with an indented continuation), and only
    # when Git itself parses it as a trailer of the final trailer block (a
    # prose paragraph that merely quotes it is body text and is kept). Body text and other contributors'
    # Co-authored-by lines are untouched. Published history is not rewritten.
    git_guard_coauthor_legacy='Co-authored-by: Codex <codex@users.noreply.github.com>'
    git_guard_coauthor_draft='Co-authored-by: Codex <codex@agents.invalid>'
    # Comment lines use core.commentString / core.commentChar (default "#").
    # With "auto", git picks the first of `#;@!$%^&|:` that starts no line of
    # the message and APPENDS its comment block, so the last non-blank line's
    # first character is the one it chose. Use that, and hand the same
    # character to every interpret-trailers call below, so the trailer block
    # above those comments is found.
    git_guard_comment="$(git config --get core.commentString 2>/dev/null ||
      git config --get core.commentChar 2>/dev/null || echo '#')"
    git_guard_comment_override=""
    if [ "$git_guard_comment" = "auto" ]; then
      git_guard_last_char="$(awk 'NF { l = $0 } END { print substr(l, 1, 1) }' "$message_file")"
      case "$git_guard_last_char" in
        '#'|';'|'@'|'!'|'$'|'%'|'^'|'&'|'|'|':') git_guard_comment="$git_guard_last_char" ;;
        *) git_guard_comment='#' ;;
      esac
      git_guard_comment_override="$git_guard_comment"
    fi
    [ -n "$git_guard_comment" ] || git_guard_comment='#'
    git_guard_trailers() {
      if [ -n "$git_guard_comment_override" ]; then
        git -c core.commentChar="$git_guard_comment_override" interpret-trailers "$@"
      else
        git interpret-trailers "$@"
      fi
    }
    if git_guard_trailers --parse "$message_file" 2>/dev/null |
       grep -qxF -e "$git_guard_coauthor_legacy" -e "$git_guard_coauthor_draft"; then
      git_guard_msg_tmp="${message_file}.git-guard.$$"
      if ! awk -v legacy="$git_guard_coauthor_legacy" -v draft="$git_guard_coauthor_draft" -v cc="$git_guard_comment" '
        function is_comment(s) { return substr(s, 1, length(cc)) == cc }
        { line[NR] = $0 }
        END {
          last = 0
          for (i = NR; i >= 1; i--) {
            if (!is_comment(line[i]) && line[i] !~ /^[[:space:]]*$/) { last = i; break }
          }
          start = last
          while (start > 1 && line[start - 1] !~ /^[[:space:]]*$/) start--
          for (i = 1; i <= NR; i++) {
            # Skip only a COMPLETE logical trailer: an exact generated line
            # whose next line is not an indented continuation. A folded
            # trailer has a different parsed value and is kept whole, so no
            # continuation is orphaned and the block stays parseable.
            if (start > 1 && i >= start && i <= last && (line[i] == legacy || line[i] == draft) &&
                !(i < last && line[i + 1] ~ /^[ \t]/)) continue
            print line[i]
          }
        }
      ' "$message_file" > "$git_guard_msg_tmp"; then
        rm -f "$git_guard_msg_tmp"
        printf 'git-guard prepare-commit-msg: could not rewrite %s\n' "$message_file" >&2
        exit 1
      fi
      cat "$git_guard_msg_tmp" > "$message_file"
      rm -f "$git_guard_msg_tmp"
    fi
    # Add the co-author first, then replace/add Agent at the end, without
    # replacing another contributor's Co-authored-by trailer.
    git_guard_trailers --in-place \
      --if-exists addIfDifferent \
      --if-missing add \
      --trailer 'Co-authored-by: Codex <noreply@openai.com>' \
      --if-exists replace \
      --trailer 'Agent: codex' \
      "$message_file"
    ;;
  claude)
    git interpret-trailers --in-place \
      --if-exists replace \
      --if-missing add \
      --trailer 'Agent: claude' \
      "$message_file"
    ;;
esac
