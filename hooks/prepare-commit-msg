#!/bin/sh
# Deterministically attribute commits created by AI coding agents.
#
#   Codex       -> `Agent: codex` + `Co-authored-by: Codex <noreply@openai.com>`
#   Claude Code -> `Agent: claude` (Claude writes its own Co-authored-by, which
#                  names the model, so the hook never adds or duplicates one)
#   Gemini      -> `Agent: gemini` (selected with GIT_GUARD_AGENT=gemini)
#   Copilot     -> `Agent: copilot` (selected with GIT_GUARD_AGENT=copilot)
#   human       -> no trailer; an Agent trailer must name a known agent
#
# Git always runs prepare-commit-msg, even with --no-verify. A human who must
# make an emergency commit can bypass this hook explicitly with GIT_GUARD=0.
# The message source ($2: message/template/merge/squash/commit) is deliberately
# not special-cased: every commit an agent creates is attributed the same way.

set -u

if [ "${GIT_GUARD:-1}" = "0" ]; then
  exit 0
fi

message_file="${1:-}"
if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  printf 'git-guard prepare-commit-msg: commit message file is missing\n' >&2
  exit 1
fi

# An explicit agent selector takes precedence. Otherwise:
#   * CODEX_THREAD_ID is the stable process-level signal exported by Codex CLI.
#     Only that variable counts: Claude Code shells can carry unrelated CODEX_*
#     configuration (CODEX_MODEL, CODEX_ENABLED, ...).
#   * CLAUDECODE=1 / CLAUDE_CODE_ENTRYPOINT are exported by Claude Code into
#     every shell it spawns.
# Codex outranks Claude: a Codex process launched from inside Claude Code
# inherits CLAUDECODE=1 but carries its own CODEX_THREAD_ID, and the
# per-process marker beats the inherited ancestor marker.
#
# Known agents are the fleet's stable agent ids (agent-bus presence and
# docs/IDENTITY.md): claude, codex, gemini, copilot and jules. A trailer may add
# a lane suffix to one of them (`gemini-dtm-oto-mesh`, `codex-asus`), as fleet
# history does. Only claude and codex are detected from the environment
# (Antigravity and Copilot export no marker of their own), so gemini and copilot
# are selected explicitly with GIT_GUARD_AGENT. An unknown selector is refused
# rather than read as "human": treating it as human used to skip every check
# below, so any made-up selector, or a typo, passed silently.
git_guard_known_agents='claude codex gemini copilot jules'

# git_guard_trailer_seps — print every character Git may read as a trailer
# separator: `:` plus trailer.separators. Git then reads `Agent=gemnii` as the
# Agent trailer `gemnii` under `trailer.separators=:=` (codex review of #106 at
# cbd9dc60, P2). `:` is always kept, although a setting without it stops Git
# reading `Agent: x`, so the check never loosens. Fails when Git cannot read
# its configuration, so the callers refuse instead of checking nothing.
git_guard_trailer_seps() {
  _gg_ts="$(git config --get trailer.separators)"
  case $? in
    0) ;;
    1) _gg_ts="" ;;
    *) return 1 ;;
  esac
  printf ':%s' "$_gg_ts"
}

# awk function shared by both Agent scans. agent_trailer(line) is 1 when line
# is an Agent trailer as Git reads it, and sets AV to the value. Like Git's
# find_separator, a separator straight after the token wins over whitespace,
# then spaces or tabs may sit between the token and the separator. The token is
# matched case-insensitively. Separators come from ENVIRON["GG_TRAILER_SEPS"]:
# -v would expand backslash escapes in them.
git_guard_awk_agent_trailer='
  function agent_trailer(line,   rest, c, seps) {
    seps = ENVIRON["GG_TRAILER_SEPS"]
    if (tolower(substr(line, 1, 5)) != "agent") return 0
    rest = substr(line, 6)
    c = substr(rest, 1, 1)
    if (c == "" || index(seps, c) == 0) {
      if (c != " " && c != "\t") return 0
      sub(/^[ \t]+/, "", rest)
      c = substr(rest, 1, 1)
      if (c == "" || index(seps, c) == 0) return 0
    }
    AV = substr(rest, 2)
    sub(/^[[:space:]]+/, "", AV); sub(/[[:space:]]+$/, "", AV)
    return 1
  }
'

# git_guard_scan_agents — print the first Agent value on stdin that is not one
# known id, or nothing. The value is ONE id, compared whole against each known
# id: `claude codex` names no single agent even though it is a substring of the
# list. An indented continuation line is part of the value, as Git folds it
# (`Agent: codex` + `  other` is `codex other`), so it is validated too. Every
# line is read: there is no scissors boundary (see git_guard_unknown_agent).
# An Agent line is one Git reads as a trailer with any separator in $_gg_seps.
git_guard_scan_agents() {
  GG_TRAILER_SEPS="$_gg_seps" awk -v known="$git_guard_known_agents" "$git_guard_awk_agent_trailer"'
    BEGIN { nk = split(known, k, " "); for (i = 1; i <= nk; i++) ok[k[i]] = 1; pending = 0; bad = "" }
    function check(v,   id, base) {
      sub(/^[[:space:]]+/, "", v); sub(/[[:space:]]+$/, "", v)
      id = tolower(v)
      base = ""
      # A lane suffix keeps the base id: gemini-dtm-oto-mesh -> gemini.
      if (id ~ /^[a-z]+(-[a-z0-9][a-z0-9-]*)?$/) { base = id; sub(/-.*/, "", base) }
      if (base == "" || !(base in ok)) bad = (v == "" ? "<empty>" : v)
    }
    bad != "" { next }
    pending && /^[ \t]+[^ \t]/ {
      cont = $0
      sub(/^[ \t]+/, "", cont); sub(/[[:space:]]+$/, "", cont)
      value = value " " cont
      next
    }
    pending { check(value); pending = 0; if (bad != "") next }
    agent_trailer($0) { value = AV; pending = 1 }
    END { if (bad == "" && pending) check(value); if (bad != "") print bad }
  '
}

# git_guard_unknown_agent FILE — print the first unknown Agent value in FILE as
# Git may record it, or nothing. Returns 2 when the message cannot be read.
#
# The hook cannot see `-v`, `--no-verbose` or `--cleanup`, so it cannot know
# what Git will keep (codex review of #106 at fe8e5f9f, two P2s). It therefore
# checks every reading Git might make, and refuses if any of them is unknown:
#   * The raw message, for whitespace and verbatim cleanup, where comment
#     lines stay in the message as ordinary text and end a folded value.
#   * The message with comment lines stripped by `git stripspace`, for strip
#     cleanup. Git strips before it folds, so `Agent: codex` + `# note` +
#     `  unknown` is recorded as `codex unknown`. stripspace applies the
#     effective core.commentChar / core.commentString. For `auto` it falls back
#     to `#`, while Git may pick any of `#;@!$%^&|:`, so each is tried.
# There is no scissors boundary. Git cuts at its scissors line only in verbose
# or scissors cleanup, and only when the marker uses its comment character. A
# `#` marker under core.commentChar=';', or under strip cleanup without `-v`, is
# not a cut, and an `Agent:` line below it was recorded. Everything Git itself
# writes below the marker is a comment or a prefixed diff line, so none of it
# can match. The one cost: an unknown `Agent:` line typed below a real `-v`
# scissors line, which Git would discard, is still refused.
git_guard_unknown_agent() {
  _gg_seps="$(git_guard_trailer_seps)" || return 2
  _gg_bad="$(git_guard_scan_agents < "$1")" || return 2
  if [ -n "$_gg_bad" ]; then
    printf '%s\n' "$_gg_bad"
    return 0
  fi
  _gg_file="$1"
  _gg_cc="$(git config --get-regexp '^core\.comment(char|string)$')"
  case $? in
    0) _gg_cc="$(printf '%s\n' "$_gg_cc" | tail -n 1)" ;;
    1) _gg_cc="" ;;
    *) return 2 ;;
  esac
  case "$_gg_cc" in
    *' auto') set -- '#' ';' '@' '!' '$' '%' '^' '&' '|' ':' ;;
    *) set -- '' ;;
  esac
  for _gg_c in "$@"; do
    if [ -n "$_gg_c" ]; then
      _gg_stripped="$(git -c core.commentChar="$_gg_c" stripspace --strip-comments < "$_gg_file")" || return 2
    else
      _gg_stripped="$(git stripspace --strip-comments < "$_gg_file")" || return 2
    fi
    _gg_bad="$(printf '%s\n' "$_gg_stripped" | git_guard_scan_agents)" || return 2
    if [ -n "$_gg_bad" ]; then
      printf '%s\n' "$_gg_bad"
      return 0
    fi
  done
}

git_guard_refuse_unknown_agent() {
  _gg_bad="$(git_guard_unknown_agent "$1")"
  _gg_rc=$?
  if [ "$_gg_rc" -ne 0 ]; then
    printf 'git-guard %s: cannot check the Agent trailers: Git could not read its configuration or the message\n' "$2" >&2
    return 1
  fi
  [ -n "$_gg_bad" ] || return 0
  printf "git-guard %s: unknown Agent trailer '%s' (known: %s)\n" \
    "$2" "$_gg_bad" "$git_guard_known_agents" >&2
  printf 'Set GIT_GUARD=0 only for an intentional human emergency commit.\n' >&2
  return 1
}

# commit-msg runs `prepare-commit-msg FILE --check-agents` on the FINAL
# message. The editor opens after this hook, so a value typed there was never
# checked: an interactive `Agent: gemnii` landed while the same `-m` commit was
# refused (codex review of #106 at 4e6325ea, P2). This mode runs only the
# known-agent check, in every shell, and never edits FILE. Git's own second
# argument is a message source (message, template, merge, squash, commit),
# never this flag.
if [ "${2:-}" = "--check-agents" ]; then
  git_guard_refuse_unknown_agent "$message_file" commit-msg || exit 1
  exit 0
fi

case "${GIT_GUARD_AGENT:-}" in
  codex|claude|gemini|copilot) agent="$GIT_GUARD_AGENT" ;;
  "")
    if [ -n "${CODEX_THREAD_ID:-}" ]; then
      agent=codex
    elif [ "${CLAUDECODE:-}" = "1" ] || [ -n "${CLAUDE_CODE_ENTRYPOINT:-}" ]; then
      agent=claude
    else
      agent=""
    fi
    ;;
  *)
    printf "git-guard prepare-commit-msg: unknown GIT_GUARD_AGENT '%s' (known: claude codex gemini copilot)\n" \
      "$GIT_GUARD_AGENT" >&2
    printf 'Set GIT_GUARD=0 only for an intentional human emergency commit.\n' >&2
    exit 1
    ;;
esac

if [ -z "$agent" ]; then
  # Human shell. A commit with no Agent trailer is the owner's own and passes
  # untouched; a trailer that records an agent's work must name a known agent,
  # so a typo cannot create an attribution no tooling recognises.
  git_guard_refuse_unknown_agent "$message_file" prepare-commit-msg || exit 1
  exit 0
fi

# Inspect every trailer-shaped Agent line, including case, whitespace and
# trailer.separators forms Git accepts. Multiple `git commit -m` paragraphs can
# put blank lines between trailers, so checking only `interpret-trailers
# --parse` is insufficient.
if ! _gg_seps="$(git_guard_trailer_seps)"; then
  printf 'git-guard prepare-commit-msg: cannot check the Agent trailers: Git could not read its configuration\n' >&2
  exit 1
fi
conflicting_agent="$(GG_TRAILER_SEPS="$_gg_seps" awk -v agent="$agent" "$git_guard_awk_agent_trailer"'
  BEGIN { conflict = "" }
  agent_trailer($0) {
    if (tolower(AV) != agent && conflict == "") {
      conflict = (AV == "" ? "<empty>" : AV)
    }
  }
  END { printf "%s\n", conflict }
' "$message_file")"

if [ -n "$conflicting_agent" ]; then
  printf 'git-guard prepare-commit-msg: conflicting Agent trailer: %s (detected agent: %s)\n' \
    "$conflicting_agent" "$agent" >&2
  printf 'Set GIT_GUARD=0 only for an intentional human emergency commit.\n' >&2
  exit 1
fi

# A matching Agent line in an earlier paragraph is body text, not a parsed
# trailer. Let Git find the final trailer block; retain that earlier text.
# `--if-exists replace` canonicalizes Agent's spelling and keeps repeated hook
# invocations byte-identical.
# Comment lines use core.commentString / core.commentChar (default "#").
# With "auto", git picks the first of `#;@!$%^&|:` that starts no line of
# the message and appends its comment block. A verbose diff follows a
# scissors marker in that character; take the last exact marker so a literal
# earlier body marker cannot select the wrong character. Without a verbose
# diff, use the last nonblank comment line. Apply it to both agents.
git_guard_comment="$(git config --get core.commentString 2>/dev/null ||
  git config --get core.commentChar 2>/dev/null || echo '#')"
git_guard_comment_override=""
if [ "$git_guard_comment" = "auto" ]; then
  git_guard_last_char="$(awk '
    NF { l = $0 }
    substr($0, 2) == " ------------------------ >8 ------------------------" &&
      substr($0, 1, 1) ~ /^[#;@!$%^&|:]$/ {
        scissors = substr($0, 1, 1)
      }
    END { print scissors == "" ? substr(l, 1, 1) : scissors }
  ' "$message_file")"
  case "$git_guard_last_char" in
    '#'|';'|'@'|'!'|'$'|'%'|'^'|'&'|'|'|':') git_guard_comment="$git_guard_last_char" ;;
    *) git_guard_comment='#' ;;
  esac
  git_guard_comment_override="$git_guard_comment"
fi
[ -n "$git_guard_comment" ] || git_guard_comment='#'
git_guard_trailers() {
  if [ -n "$git_guard_comment_override" ]; then
    git -c core.commentChar="$git_guard_comment_override" interpret-trailers "$@"
  else
    git interpret-trailers "$@"
  fi
}
case "$agent" in
  codex)
    # Codex co-author: `Codex <noreply@openai.com>`, the address the Codex CLI
    # itself writes (openai/codex codex-rs/ext/git-attribution/src/world_state.rs)
    # and OpenAI's documented default. Owner decision 2026-10-03, for
    # consistency with Codex-authored commits; GitHub links it to OpenAI's own
    # `codex` account, as it already did for the earlier address.
    #
    # Earlier generated forms are COLLAPSED into it rather than duplicated:
    #   Codex <codex@users.noreply.github.com>   this hook until 2026-10-03
    #   Codex <codex@agents.invalid>             an unmerged draft of this change
    # Each is removed ONLY as that exact, complete logical trailer (never the
    # first line of a folded trailer with an indented continuation), and only
    # when Git itself parses it as a trailer of the final trailer block (a
    # prose paragraph that merely quotes it is body text and is kept). Body text and other contributors'
    # Co-authored-by lines are untouched. Published history is not rewritten.
    git_guard_coauthor_legacy='Co-authored-by: Codex <codex@users.noreply.github.com>'
    git_guard_coauthor_draft='Co-authored-by: Codex <codex@agents.invalid>'
    if git_guard_trailers --parse "$message_file" 2>/dev/null |
       grep -qxF -e "$git_guard_coauthor_legacy" -e "$git_guard_coauthor_draft"; then
      git_guard_msg_tmp="${message_file}.git-guard.$$"
      if ! awk -v legacy="$git_guard_coauthor_legacy" -v draft="$git_guard_coauthor_draft" -v cc="$git_guard_comment" '
        function is_comment(s) { return substr(s, 1, length(cc)) == cc }
        { line[NR] = $0 }
        END {
          # Git excludes the verbose diff below its scissors marker from
          # the commit message. It must not hide the real trailer paragraph.
          limit = NR
          for (i = 1; i <= NR; i++) {
            if (line[i] == cc " ------------------------ >8 ------------------------") {
              limit = i - 1
              break
            }
          }
          last = 0
          for (i = limit; i >= 1; i--) {
            if (!is_comment(line[i]) && line[i] !~ /^[[:space:]]*$/) { last = i; break }
          }
          start = last
          while (start > 1 && line[start - 1] !~ /^[[:space:]]*$/) start--
          for (i = 1; i <= NR; i++) {
            # Skip only a COMPLETE logical trailer: an exact generated line
            # whose next line is not an indented continuation. A folded
            # trailer has a different parsed value and is kept whole, so no
            # continuation is orphaned and the block stays parseable.
            if (start > 1 && i >= start && i <= last && (line[i] == legacy || line[i] == draft) &&
                !(i < last && line[i + 1] ~ /^[ \t]/)) continue
            print line[i]
          }
        }
      ' "$message_file" > "$git_guard_msg_tmp"; then
        rm -f "$git_guard_msg_tmp"
        printf 'git-guard prepare-commit-msg: could not rewrite %s\n' "$message_file" >&2
        exit 1
      fi
      cat "$git_guard_msg_tmp" > "$message_file"
      rm -f "$git_guard_msg_tmp"
    fi
    # Add the co-author first, then replace/add Agent at the end, without
    # replacing another contributor's Co-authored-by trailer.
    git_guard_trailers --in-place \
      --if-exists addIfDifferent \
      --if-missing add \
      --trailer 'Co-authored-by: Codex <noreply@openai.com>' \
      --if-exists replace \
      --trailer 'Agent: codex' \
      "$message_file"
    ;;
  claude|gemini|copilot)
    # None gets a hook-written co-author: Claude writes its own (it names the
    # model); Gemini's and Copilot's attribution is their signing key plus this
    # trailer.
    git_guard_trailers --in-place \
      --if-exists replace \
      --if-missing add \
      --trailer "Agent: $agent" \
      "$message_file"
    ;;
esac
