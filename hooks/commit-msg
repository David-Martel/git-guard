#!/bin/sh
#
# git-guard commit-msg — completes the preserve/* exemption.
#
# On a preserve/* branch, pre-commit runs only the structural checks and leaves
# a deferral marker, because the commit message (and so the `Preserve-Of:`
# trailer) does not exist yet at pre-commit time. Here the marker is consumed:
# a valid trailer logs the exemption and passes; anything else runs the
# deferred QA (the full pre-commit) now. With no marker this is a no-op.
# See hooks/common/preserve.sh and docs/QA_TOOLING.md "preserve/* exemption".
#
# Bypass: `GIT_GUARD=0 git commit ...`. Do NOT use --no-verify.

if [ "$GIT_GUARD" = "0" ] || [ "$LEFTHOOK" = "0" ]; then
  exit 0
fi

git_guard_hook_dir="$(cd "$(dirname "$0")" && pwd -P)"

# 0 = exempted (a later commit-msg downstream chain is skipped too),
# 3 = not exempted (carry on), anything else = blocked.
if [ -x "$git_guard_hook_dir/common/preserve.sh" ]; then
  "$git_guard_hook_dir/common/preserve.sh" commit-msg "$1"; git_guard_preserve_rc=$?
  [ "$git_guard_preserve_rc" -eq 3 ] || exit "$git_guard_preserve_rc"
fi

exit 0
